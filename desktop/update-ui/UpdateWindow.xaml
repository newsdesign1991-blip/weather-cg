<!-- 날씨 CG 업데이트 진행 창의 모양 — 영상 플레이어(NewsPlayer) 설치 프로그램의 업데이트 창(Installer\UpdateWindow.xaml)을 옮긴 것.
     날씨 CG 토스 카드(css/base.css 어두운 토큰·css/toss-modal.css 머리 틴트)와 같은 색: 카드 #212121, 파랑 강조 #3182F6(그라데이션 #4A94FF → #2F77F6),
     완료 초록 #2FB86C, 문제 빨강 #FF6B6B. 글꼴은 Wanted Sans(앱 UI 글꼴 — 창 프로그램이 함께 담은 정적 판 'Wanted Sans NP').
     빌드(tools/build-update-ui.cjs)가 이 파일을 exe 안에 넣고, 창 프로그램(UpdateApp.cs)이 XamlReader 로 읽는다 — x:Class·이벤트 이름은 쓰지 않는다(코드에서 x:Name 으로 찾아 건다). -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="날씨 CG 업데이트" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" UseLayoutRounding="True" ShowInTaskbar="True" TextOptions.TextFormattingMode="Ideal">
    <Window.Resources>
        <SolidColorBrush x:Key="T.Card" Color="#212121"/>
        <SolidColorBrush x:Key="T.Fg" Color="#F1F1F1"/>
        <SolidColorBrush x:Key="T.Muted" Color="#A3A3A3"/>
        <SolidColorBrush x:Key="T.SurfaceHi" Color="#272727"/>
        <SolidColorBrush x:Key="T.Outline" Color="#303030"/>
        <SolidColorBrush x:Key="T.BtnHover" Color="#323232"/>
        <SolidColorBrush x:Key="T.Head" Color="#146AA8FF"/>
        <SolidColorBrush x:Key="T.HeadLine" Color="#216AA8FF"/>
        <SolidColorBrush x:Key="T.Danger" Color="#FF6B6B"/>
        <SolidColorBrush x:Key="T.Ok" Color="#2FB86C"/>
        <SolidColorBrush x:Key="T.Accent" Color="#3182F6"/>
        <SolidColorBrush x:Key="T.AccentText" Color="#7DB3FF"/>
        <LinearGradientBrush x:Key="T.AccentGrad" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4A94FF" Offset="0"/>
            <GradientStop Color="#2F77F6" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="T.Refl" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#33FFFFFF" Offset="0"/>
            <GradientStop Color="#0DFFFFFF" Offset="0.4"/>
            <GradientStop Color="#52000000" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="TossBtn" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="76"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource T.Fg}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{StaticResource T.SurfaceHi}" BorderBrush="{StaticResource T.Outline}"
                                BorderThickness="1" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource T.BtnHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TossPrimary" TargetType="Button" BasedOn="{StaticResource TossBtn}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{StaticResource T.AccentGrad}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#3182F6" BlurRadius="12" ShadowDepth="4" Direction="270" Opacity="0.5"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GlassX" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="16" Background="#8C323232" BorderBrush="#1FFFFFFF" BorderThickness="1">
                            <Viewbox Width="15" Height="15">
                                <Canvas Width="24" Height="24">
                                    <Path Stroke="{StaticResource T.Fg}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M6.5,6.5 L17.5,17.5 M17.5,6.5 L6.5,17.5"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#B84E4E4E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 카드 둘레는 그림자 자리 -->
    <Border x:Name="Card" Margin="30,24,30,40" CornerRadius="20" Background="{StaticResource T.Card}" BorderBrush="{StaticResource T.Refl}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="50" ShadowDepth="16" Direction="270" Opacity="0.6" Color="Black"/>
        </Border.Effect>
        <DockPanel>
            <Border x:Name="Head" DockPanel.Dock="Top" CornerRadius="19,19,0,0" Padding="20,13,14,13" BorderThickness="0,0,0,1"
                    Background="{StaticResource T.Head}" BorderBrush="{StaticResource T.HeadLine}">
                <DockPanel MinHeight="32">
                    <!-- 문제로 멈췄을 때만 보인다(도는 동안에는 닫을 수 없다) -->
                    <Button x:Name="CloseX" DockPanel.Dock="Right" Style="{StaticResource GlassX}" Visibility="Collapsed" ToolTip="닫기"/>
                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Text="업데이트 설치 중" FontSize="16" FontWeight="ExtraBold"
                                   Foreground="{StaticResource T.Fg}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="VersionText" FontSize="12" Foreground="{StaticResource T.Muted}" VerticalAlignment="Center"/>
                    </WrapPanel>
                </DockPanel>
            </Border>

            <StackPanel Margin="20,18,20,18">
                <!-- 단계 목록(UpdateApp.cs 가 채움) -->
                <StackPanel x:Name="Steps"/>

                <Grid Height="8" Margin="0,8,0,0">
                    <Border x:Name="Track" Background="{StaticResource T.SurfaceHi}" BorderBrush="{StaticResource T.Outline}"
                            BorderThickness="1" CornerRadius="4"/>
                    <Border x:Name="Bar" Background="{StaticResource T.AccentGrad}" CornerRadius="4" HorizontalAlignment="Left" Width="0"/>
                </Grid>
                <DockPanel Margin="0,9,0,0">
                    <TextBlock x:Name="Percent" DockPanel.Dock="Right" Foreground="{StaticResource T.Fg}" FontSize="13" FontWeight="Bold" Margin="10,0,0,0"/>
                    <TextBlock x:Name="Status" Foreground="{StaticResource T.Muted}" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <TextBlock x:Name="Note" Foreground="{StaticResource T.Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" Opacity="0.8"
                           Text="작업·배치·설정은 그대로예요. 끝나면 새 버전이 켜지고 이 창은 저절로 닫혀요."/>

                <!-- 문제: 무슨 일인지와 고를 것 -->
                <StackPanel x:Name="ErrorPanel" Visibility="Collapsed" Margin="0,16,0,0">
                    <TextBlock x:Name="ErrorText" Foreground="{StaticResource T.Fg}" FontSize="13" FontWeight="Bold" TextWrapping="Wrap" LineHeight="20"/>
                    <TextBlock x:Name="ErrorHint" Foreground="{StaticResource T.Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <DockPanel LastChildFill="False" Margin="0,18,0,0">
                        <Button x:Name="CloseBtn" Style="{StaticResource TossBtn}" Content="닫기"/>
                        <Button x:Name="RetryBtn" DockPanel.Dock="Right" Style="{StaticResource TossPrimary}" Content="다시 시도" Margin="8,0,0,0"/>
                        <Button x:Name="OldBtn" DockPanel.Dock="Right" Style="{StaticResource TossBtn}" Content="예전 판 그대로 켜기"/>
                    </DockPanel>
                </StackPanel>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
