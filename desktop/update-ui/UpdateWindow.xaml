<!-- 날씨 CG 업데이트 진행 창의 모양 — 10-21부터 근무표 설치 도우미의 업데이트 창(work schedule\desktop\setup-ui\SetupWindow.xaml)과 같은 결(사용자 요청):
     흰 카드, 글자 #1E293B·#334155·#64748B·#94A3B8(슬레이트), 머리 = 옅은 색 틴트 + 앱 로고(icon-192.png를 exe 에 담음) · 제목 · 버전,
     파랑 #4A94FF → #2F77F6, 완료 초록 #10B981, 문제 빨강 #EF4444(끝·문제 때 머리·막대 색이 바뀐다 — UpdateApp.cs Tone).
     글꼴은 Wanted Sans(창 프로그램이 함께 담은 정적 판 'Wanted Sans NP').
     빌드(tools/build-update-ui.cjs)가 이 파일을 exe 안에 넣고, 창 프로그램(UpdateApp.cs)이 XamlReader 로 읽는다 — x:Class·이벤트 이름은 쓰지 않는다(코드에서 x:Name 으로 찾아 건다). -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="날씨 CG 업데이트" Width="600" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" UseLayoutRounding="True" ShowInTaskbar="True" TextOptions.TextFormattingMode="Ideal">
    <Window.Resources>
        <SolidColorBrush x:Key="T.Card" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="T.Fg" Color="#1E293B"/>
        <SolidColorBrush x:Key="T.Text" Color="#334155"/>
        <SolidColorBrush x:Key="T.Muted" Color="#64748B"/>
        <SolidColorBrush x:Key="T.Faint" Color="#94A3B8"/>
        <SolidColorBrush x:Key="T.SurfaceHi" Color="#EEF2F7"/>
        <SolidColorBrush x:Key="T.Outline" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="T.BtnHover" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="T.Head" Color="#EAF2FE"/>
        <SolidColorBrush x:Key="T.HeadLine" Color="#D6E6FD"/>
        <SolidColorBrush x:Key="T.HeadOk" Color="#E7F8F2"/>
        <SolidColorBrush x:Key="T.HeadOkLine" Color="#C6EEDF"/>
        <SolidColorBrush x:Key="T.HeadFail" Color="#FEF0F0"/>
        <SolidColorBrush x:Key="T.HeadFailLine" Color="#FBD5D5"/>
        <SolidColorBrush x:Key="T.Accent" Color="#3182F6"/>
        <SolidColorBrush x:Key="T.AccentText" Color="#2563EB"/>
        <SolidColorBrush x:Key="T.Ok" Color="#10B981"/>
        <SolidColorBrush x:Key="T.OkText" Color="#047857"/>
        <SolidColorBrush x:Key="T.Danger" Color="#EF4444"/>
        <SolidColorBrush x:Key="T.DangerText" Color="#DC2626"/>
        <LinearGradientBrush x:Key="T.AccentGrad" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4A94FF" Offset="0"/>
            <GradientStop Color="#2F77F6" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="T.OkGrad" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#34D399" Offset="0"/>
            <GradientStop Color="#10B981" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="T.DangerGrad" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F87171" Offset="0"/>
            <GradientStop Color="#EF4444" Offset="1"/>
        </LinearGradientBrush>

        <!-- 보조 단추(옅은 회색) -->
        <Style x:Key="TossBtn" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="84"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource T.Text}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{StaticResource T.SurfaceHi}" BorderBrush="Transparent" BorderThickness="1.5"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource T.BtnHover}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="#933182F6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 주 단추(파랑 그라데이션) -->
        <Style x:Key="TossPrimary" TargetType="Button" BasedOn="{StaticResource TossBtn}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="MinWidth" Value="108"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{StaticResource T.AccentGrad}" BorderBrush="Transparent" BorderThickness="1.5"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#3182F6" BlurRadius="14" ShadowDepth="4" Direction="270" Opacity="0.35"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="#B3FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 머리 오른쪽 닫기(X) -->
        <Style x:Key="GlassX" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="16" Background="#0F0F172A">
                            <Viewbox Width="14" Height="14">
                                <Canvas Width="24" Height="24">
                                    <Path Stroke="#475569" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M6.5,6.5 L17.5,17.5 M17.5,6.5 L6.5,17.5"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1F0F172A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 카드 둘레는 그림자 자리 -->
    <Border x:Name="Card" Margin="28,22,28,38" CornerRadius="20" Background="{StaticResource T.Card}"
            BorderBrush="{StaticResource T.Outline}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="10" Direction="270" Opacity="0.22" Color="#0F172A"/>
        </Border.Effect>
        <DockPanel>
            <!-- 머리: 앱 로고 · 제목 · 버전 (색 틴트: 파랑 = 진행, 초록 = 끝, 빨강 = 문제) -->
            <Border x:Name="Head" DockPanel.Dock="Top" CornerRadius="19,19,0,0" Padding="20,16,14,16" BorderThickness="0,0,0,1"
                    Background="{StaticResource T.Head}" BorderBrush="{StaticResource T.HeadLine}">
                <DockPanel>
                    <!-- 문제로 멈췄을 때만 보인다(도는 동안에는 닫을 수 없다) -->
                    <Button x:Name="CloseX" DockPanel.Dock="Right" VerticalAlignment="Top" Style="{StaticResource GlassX}" Visibility="Collapsed" ToolTip="닫기"/>
                    <Image x:Name="AppIcon" DockPanel.Dock="Left" Width="52" Height="52" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="14,0,8,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Text="업데이트 설치 중" FontSize="19" FontWeight="Bold" Foreground="{StaticResource T.Fg}"/>
                        <TextBlock x:Name="VersionText" FontSize="12.5" Foreground="{StaticResource T.Muted}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <StackPanel Margin="22,18,22,22">
                <!-- 단계 목록(UpdateApp.cs 가 채움) -->
                <StackPanel x:Name="Steps"/>

                <Grid Height="8" Margin="0,6,0,0">
                    <Border x:Name="Track" Background="{StaticResource T.SurfaceHi}" CornerRadius="4"/>
                    <Border x:Name="Bar" Background="{StaticResource T.AccentGrad}" CornerRadius="4" HorizontalAlignment="Left" Width="0"/>
                </Grid>
                <DockPanel Margin="0,9,0,0">
                    <TextBlock x:Name="Percent" DockPanel.Dock="Right" Foreground="{StaticResource T.Fg}" FontSize="13" FontWeight="Bold" Margin="10,0,0,0"/>
                    <TextBlock x:Name="Status" Foreground="{StaticResource T.Muted}" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <TextBlock x:Name="Note" Foreground="{StaticResource T.Faint}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="작업·배치·설정은 그대로예요. 끝나면 새 버전이 켜지고 이 창은 저절로 닫혀요."/>

                <!-- 문제: 무슨 일인지와 고를 것 -->
                <StackPanel x:Name="ErrorPanel" Visibility="Collapsed" Margin="0,16,0,0">
                    <TextBlock x:Name="ErrorText" Foreground="{StaticResource T.Fg}" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" LineHeight="21"/>
                    <TextBlock x:Name="ErrorHint" Foreground="{StaticResource T.Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="19"/>
                    <DockPanel LastChildFill="False" Margin="0,20,0,0">
                        <Button x:Name="CloseBtn" Style="{StaticResource TossBtn}" Content="닫기"/>
                        <Button x:Name="RetryBtn" DockPanel.Dock="Right" Style="{StaticResource TossPrimary}" Content="다시 시도" Margin="8,0,0,0"/>
                        <Button x:Name="OldBtn" DockPanel.Dock="Right" Style="{StaticResource TossBtn}" Content="예전 판 그대로 켜기"/>
                    </DockPanel>
                </StackPanel>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
